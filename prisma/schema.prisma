// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ContentType {
  VIDEO
  SINGLE_IMAGE
  MULTIPLE_IMAGES
  TEXT_POST
}

enum UserRole {
  CREATOR
  BUSINESS
}

enum CreatorType {
  YOUTUBER
  COMEDIAN
  INFLUENCER
  MUSICIAN
  DANCER
  PHOTOGRAPHER
  PODCASTER
  ACTOR
}

model UserProfile {
  id              String           @id @default(uuid())
  username        String           @unique
  email           String           @unique
  password        String?          
  image           String?
  coverImage      String?
  googleId        String?          @unique
  provider        String?
  firstName       String?
  lastName        String?
  role            UserRole         @default(CREATOR)

  creatorProfile  CreatorProfile?
  businessProfile BusinessProfile?
  youtubeStats    YouTubeStats?
  youTubeAuth     YouTubeAuth?
  requestsSent     Connection[]    @relation("RequestSent")
  requestsReceived Connection[]    @relation("RequestReceived")
  conversationParticipants ConversationParticipant[]
  sentMessages     Message[] @relation("UserMessages")

  emailVerified   Boolean          @default(false)

  otp             String?
  otpExpiry       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Connection {
  id            String      @id @default(uuid())
  senderId   String      
  receiverId    String      
  status        ConnectionStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  sender   UserProfile @relation("RequestSent", fields: [senderId], references: [id])
  receiver UserProfile @relation("RequestReceived", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId]) 
}

model CreatorProfile {
  id             String          @id @default(uuid())
  userProfileId  String          @unique
  creatorType    CreatorType
  data           Json
  recentContent  RecentContent[] 
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  userProfile    UserProfile     @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
}

model BusinessProfile {
  id             String          @id @default(uuid())
  userProfileId  String          @unique
  companyName    String
  website        String?
  contactEmail   String
  phone          String?
  about          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  userProfile    UserProfile     @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
}

model YouTubeAuth {
  id             String   @id @default(uuid())
  userProfileId  String   @unique
  refreshToken   String
  accessToken    String?
  expiryDate     DateTime?
  scope          String?
  tokenType      String?
  googleId       String

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userProfile    UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
}

model YouTubeStats {
  id             String   @id @default(uuid())
  userProfileId  String   @unique
  stats          Json
  updatedAt      DateTime @updatedAt

  userProfile    UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
}

model RecentContent {
  id               String          @id @default(uuid())
  creatorProfileId String
  contentType      ContentType     
  title            String
  description      String?
  url              String?       
  mediaUrls        String[]       
  metrics          Json?          
  metadata         Json?          
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  creatorProfile   CreatorProfile  @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@index([creatorProfileId, contentType])
}

model Conversation {
  id           String                     @id @default(uuid())
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String        @id @default(uuid())
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id])
  user         UserProfile   @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String
  content        String?
  attachmentUrl  String?
  attachmentType String?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       UserProfile  @relation("UserMessages", fields: [senderId], references: [id])
}
